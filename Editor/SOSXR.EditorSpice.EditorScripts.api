        protected const string DisabledLabel = @"Play Mode Only";
        protected const float fieldWidth = 150f;
        protected UnityEventButtonBase() {}
        protected static UnityEngine.Rect ButtonRect(UnityEngine.Rect position);
        protected static UnityEngine.Rect FieldRect(UnityEngine.Rect position);
        public override float GetPropertyHeight(UnityEditor.SerializedProperty property, UnityEngine.GUIContent label);
        protected static string GetPropertyKey(UnityEditor.SerializedProperty property);
        protected static T GetStoredValue<T>(UnityEditor.SerializedProperty property, T defaultValue);
        public override void OnGUI(UnityEngine.Rect position, UnityEditor.SerializedProperty property, UnityEngine.GUIContent label);
        protected static void SetStoredValue<T>(UnityEditor.SerializedProperty property, T value);
        protected abstract void SOSXROnGUI(UnityEngine.Rect position, UnityEditor.SerializedProperty property, UnityEngine.GUIContent label);
    }

