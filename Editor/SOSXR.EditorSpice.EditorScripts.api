    [UnityEngine.CreateAssetMenu(fileName = @"AutoSaveConfig", menuName = @"SOSXR/AutoSaveConfig")] public class AutoSaveConfig : UnityEngine.ScriptableObject
    {
        [UnityEngine.Tooltip(@"Enable auto save functionality")] public bool Enabled;
        [UnityEngine.Min(1f)] [UnityEngine.Tooltip(@"The frequency in minutes auto save will activate")] public int Frequency = 1;
        [UnityEngine.Tooltip(@"Log a message every time the scene is auto saved")] public bool Logging;
        public AutoSaveConfig() {}
    }

